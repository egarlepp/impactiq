# App
# The Docker image runs with NODE_ENV=production. Set NODE_ENV=development only
# for `npm run dev` on your own machine; never in a deployment.
# NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
# Support contact shown as a help icon on the login/setup screens and the
# in-app header. Optional — DB-configurable at Admin → Themes →
# Support contact email takes precedence when set; this env var is
# just an ops-convenience fallback for a fresh install. Leave unset to hide
# the icon entirely until an admin configures it.
# SUPPORT_EMAIL=support@example.com

# Database
# POSTGRES_USER/PASSWORD/DB are the single source of truth for the bundled
# Postgres container's credentials (docker-compose.yml's `postgres` service
# reads them directly, and composes its own DATABASE_URL default from them
# too — see docker-compose.yml's comments). They're NOT read by the app
# itself; the app only ever reads DATABASE_URL below. Change a credential
# here AND in DATABASE_URL's user:password@.../dbname portion together —
# Compose can derive DATABASE_URL from these when running via
# `docker compose up`, but plain `.env` files have no variable expansion of
# their own, so a bare `node`/`npm run dev` process (which reads DATABASE_URL
# directly, not through Compose) needs the literal value below regardless.
# REQUIRED: docker compose refuses to start until POSTGRES_PASSWORD is set.
# Generate one with: openssl rand -hex 24
POSTGRES_USER=impactiq
POSTGRES_PASSWORD=
POSTGRES_DB=impactiq
# Under `docker compose up`, DATABASE_URL is built from the three values above,
# so leave it unset. Set it to use an external Postgres instead.
# DATABASE_URL=postgresql://impactiq:<password>@postgres:5432/impactiq
# Running `npm run dev` directly on your host (not via `docker compose up`)
# against `docker compose up postgres -d`? Use localhost instead — `postgres`
# is a Docker-network-only hostname that doesn't resolve outside a container:
# DATABASE_URL=postgresql://impactiq:<password>@localhost:5432/impactiq
# Override for a Postgres cert signed by a private CA.
# DATABASE_SSL_CA=/etc/ssl/certs/postgres-ca.pem
# Production defaults to opportunistic TLS (encrypts if the server offers
# it, connects plain otherwise — never a hard failure just because the
# target Postgres doesn't support TLS, e.g. a bundled/internal-network
# database). Set this to force strict, hard-fail-if-unavailable TLS verified
# against Node's trusted CA bundle instead — for a genuinely public/external
# Postgres with a proper publicly-trusted cert. Ignored if DATABASE_SSL_CA
# is set (that already implies strict verified TLS).
# DATABASE_SSL_REQUIRE=true

# Security-critical secrets (REQUIRED in production; 32+ chars).
# NODE_ENV=production refuses to start unless BOTH are set to 32+ chars and
# neither is still a "change-me" placeholder.
# Generate each with: openssl rand -hex 32
SESSION_SECRET=change-me-32-byte-hex-key-here-00
TOKEN_ENCRYPTION_KEY=change-me-32-byte-hex-key-here-00

# Okta
OKTA_DOMAIN=your-domain.okta.com
OKTA_CLIENT_ID=your-client-id
OKTA_CLIENT_SECRET=your-client-secret
OKTA_REDIRECT_URI=http://localhost:3000/auth/callback

# Salesforce (only when Salesforce is the CRM; the admin UI can also hold these)
# HubSpot needs no env vars: paste a service key or private app token in
# Admin → Integrations → HubSpot, then choose HubSpot on the CRM card.
SF_CLIENT_ID=your-sf-client-id
SF_CLIENT_SECRET=your-sf-client-secret
SF_REDIRECT_URI=http://localhost:3000/auth/salesforce/callback
# Override for sandboxes (test.salesforce.com) or my-domain orgs. Defaults to login.salesforce.com.
# SF_LOGIN_URL=https://test.salesforce.com

# Microsoft Graph
MS_CLIENT_ID=your-azure-client-id
MS_CLIENT_SECRET=your-azure-client-secret
MS_TENANT_ID=your-azure-tenant-id

# AI providers are configured in the app (Admin → Integrations → AI Assistant),
# not through environment variables.

# Retention culls (run in the 6h housekeeping sweep) — all optional, defaults shown
AUDIT_EVENTS_RETENTION_DAYS=1095
JOB_RUNS_RETENTION_DAYS=90
AI_REQUESTS_RETENTION_DAYS=395      # AI Assistant usage log
EVENT_WEBHOOK_DELIVERIES_RETENTION_DAYS=30  # Event webhook delivery log (finished deliveries)
EMAIL_DELIVERIES_RETENTION_DAYS=30         # Outbound email delivery log (App Health Email tile)
ATTACH_RATE_HISTORY_RETENTION_DAYS=1095
# v1.364.0: Login History (Admin → Monitoring, App Admin only) had no
# retention at all before this — grew unbounded like the three above did
# until each got its own cull.
LOGIN_EVENTS_RETENTION_DAYS=60

# v1.375.0: Admin → Monitoring & Audit → Backup & Restore — largest backup
# file the restore upload accepts, in MB (optional, default shown).
BACKUP_MAX_UPLOAD_MB=2048

# v1.424.0: how many proxies (load balancer, TLS terminator) sit in front of the
# app, 0-3. Overrides Admin → Integrations → Rate Limiting. Leave blank to use
# the admin setting (default 0).
TRUSTED_PROXY_HOPS=

# v1.425.0: optional. In setup mode (no DATABASE_URL) the wizard asks for a
# one-time token printed to the server log; set this (16+ characters) to
# choose it yourself instead.
SETUP_TOKEN=

# v1.414.0: optional error tracking. Off unless SENTRY_DSN is set. Works with
# Sentry or a self-hosted GlitchTip (same DSN format). Errors only; request
# bodies, cookies, query strings and auth headers are never sent.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
